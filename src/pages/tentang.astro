---
import about from "../data/about.json";

const paragraphs = about.body
  .split("\n")
  .filter((paragraph) => paragraph.trim() !== "");
---

<!doctype html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width" />
  <meta name="description" content={about.description || "Tentang Kopi & Kayuhan"} />
  <title>{about.title || "Tentang"} — Kopi & Kayuhan</title>
</head>

<body>
  <header>
    <a class="brand" href="/">Kopi & Kayuhan</a>

    <nav>
      <a href="/">Beranda</a>
      <a href="/cerita/">Cerita</a>
      <a href="/#galeri">Galeri</a>
      <a href="/tentang/">Tentang</a>
    </nav>
  </header>

  <main>
    {about.title && <h2>{about.title}</h2>}

    {about.description && (
      <p class="description">{about.description}</p>
    )}

    {paragraphs.map((paragraph) => (
      <p class="body-text">{paragraph}</p>
    ))}
  </main>

  <footer>
    <a href="/">Kopi & Kayuhan</a>
    <p>Secangkir kopi, sejuta cerita.</p>
  </footer>
</body>
</html>

<style>
  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    background: #f8f7f3;
    color: #292c25;
    font-family: "DM Sans", Arial, sans-serif;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  header {
    min-height: 78px;
    padding: 20px max(24px, calc((100% - 1120px) / 2));
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    border-bottom: 1px solid #e9e6dc;
  }

  .brand {
    font-family: Georgia, serif;
    font-size: 21px;
    font-weight: bold;
  }

  nav {
    display: flex;
    gap: 28px;
    color: #686a60;
    font-size: 14px;
  }

  main {
    width: min(760px, calc(100% - 48px));
    min-height: 60vh;
    margin: auto;
    padding: 70px 0 90px;
  }

  h1 {
    font-family: Georgia, serif;
    font-size: clamp(36px, 6vw, 50px);
    line-height: 1.2;
  }

  .description {
    color: #74756c;
    font-size: 18px;
    line-height: 1.8;
  }

  .body-text {
    color: #45463f;
    font-size: 16px;
    line-height: 2;
    white-space: pre-line;
  }

  footer {
    padding: 30px 24px;
    border-top: 1px solid #e9e6dc;
    text-align: center;
  }

  footer a {
    font-family: Georgia, serif;
    font-weight: bold;
  }

  footer p {
    color: #85857c;
    font-size: 12px;
  }

  @media (max-width: 600px) {
    header {
      align-items: flex-start;
      flex-direction: column;
    }

    nav {
      width: 100%;
      justify-content: space-between;
      gap: 10px;
      font-size: 12px;
    }

    main {
      width: calc(100% - 36px);
    }
  }
</style>