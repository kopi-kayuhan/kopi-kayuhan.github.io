
---
import { getCollection } from "astro:content";
import GoatCounter from "../../components/GoatCounter.astro";

const stories = await getCollection("stories");

const sortedStories = stories.sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const formatDate = (date: Date) =>
  new Intl.DateTimeFormat("id-ID", {
    day: "numeric",
    month: "long",
    year: "numeric",
  }).format(date);
---

<!doctype html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width" />
  <meta
    name="description"
    content="Kumpulan cerita Kopi & Kayuhan."
  />
  <title>Semua Cerita — Kopi & Kayuhan</title>

  <GoatCounter />
</head>

<body>
  <header class="header">
    <a href="/">Kopi & Kayuhan</a>

    <nav>
      <a href="/">Beranda</a>
      <a href="/cerita/" aria-current="page">Cerita</a>
      <a href="/#galeri">Galeri</a>
      <a href="/tentang/">Tentang</a>
    </nav>
  </header>

  <main>
    <section class="intro">
      <span class="eyebrow">CATATAN PERJALANAN</span>
      <h1>Semua Cerita</h1>
      <p>
        Kumpulan cerita tentang perjalanan, secangkir kopi,
        dan momen sederhana yang layak dikenang.
      </p>
    </section>

    <section class="stories">
      {sortedStories.length > 0 ? (
        <div class="grid">
          {sortedStories.map((story) => (
            <article class="card">
              <a href={`/cerita/${story.id}/`} class="cover">
                <img
                  src={story.data.cover}
                  alt={story.data.title}
                  loading="lazy"
                />
              </a>

              <div class="content">
                <span class="category">
                  {story.data.category}
                </span>

                <h2>
                  <a href={`/cerita/${story.id}/`}>
                    {story.data.title}
                  </a>
                </h2>

                <p>{story.data.description}</p>

                <div class="meta">
                  <time datetime={story.data.date.toISOString()}>
                    {formatDate(story.data.date)}
                  </time>

                  {story.data.location && (
                    <span>{story.data.location}</span>
                  )}
                </div>

                <!-- Visitor Counter -->
                <div class="visit-counter">
                  <svg
                    class="visit-icon"
                    xmlns="http://www.w3.org/2000/svg"
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7-10-7-10-7Z" />
                    <circle cx="12" cy="12" r="3" />
                  </svg>

                  <span
                    class="visit-count"
                    data-story-path={`/cerita/${story.id}/`}
                  >
                    Memuat...
                  </span>

                  <span class="visit-label">
                    kali dikunjungi
                  </span>
                </div>
              </div>
            </article>
          ))}
        </div>
      ) : (
        <p>Belum ada cerita yang diterbitkan.</p>
      )}
    </section>
  </main>

  <footer>
    <a href="/">Kopi & Kayuhan</a>
    <p>Secangkir kopi, sejuta cerita.</p>
  </footer>

  <!-- GoatCounter JSON Visitor Counts -->
  <script is:inline>
    (async function loadStoryVisitCounts() {
      const counters = document.querySelectorAll(".visit-count");

      await Promise.all(
        Array.from(counters).map(async (counter) => {
          const path = counter.getAttribute("data-story-path");

          if (!path) return;

          const endpoint =
            "https://kopi-kayuhan.goatcounter.com/counter/" +
            encodeURIComponent(path) +
            ".json";

          try {
            const response = await fetch(endpoint);

            if (response.status === 404) {
              counter.textContent = "0";
              return;
            }

            if (!response.ok) {
              throw new Error(
                `GoatCounter returned ${response.status}`
              );
            }

            const data = await response.json();

            counter.textContent = data.count ?? "0";
          } catch (error) {
            console.error(
              `Gagal mengambil kunjungan untuk ${path}:`,
              error
            );

            counter.textContent = "-";
          }
        })
      );
    })();
  </script>
</body>
</html>

<style>
  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    background: #f8f7f3;
    color: #292c25;
    font-family: "DM Sans", Arial, sans-serif;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  /* Header */

  .header {
    min-height: 78px;
    padding: 20px max(24px, calc((100% - 1120px) / 2));
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    border-bottom: 1px solid #e9e6dc;
  }

  .header > a,
  footer > a {
    font-family: Georgia, serif;
    font-size: 21px;
    font-weight: bold;
  }

  nav {
    display: flex;
    gap: 28px;
    color: #686a60;
    font-size: 14px;
  }

  nav a[aria-current="page"] {
    color: #59634a;
    font-weight: bold;
  }

  /* Main */

  main {
    width: min(1120px, calc(100% - 48px));
    margin: auto;
  }

  .intro {
    padding: 75px 0 45px;
    max-width: 650px;
  }

  .eyebrow,
  .category {
    color: #7a8069;
    font-size: 11px;
    font-weight: bold;
    letter-spacing: 1.5px;
  }

  h1,
  h2 {
    font-family: Georgia, serif;
  }

  h1 {
    margin: 14px 0;
    font-size: clamp(38px, 6vw, 54px);
  }

  .intro p {
    color: #74756c;
    line-height: 1.8;
  }

  .stories {
    padding-bottom: 90px;
  }

  /* Story Cards */

  .grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 25px;
  }

  .card {
    background: white;
    border: 1px solid #e8e5db;
  }

  .cover {
    display: block;
    height: 220px;
    overflow: hidden;
  }

  .cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .cover:hover img {
    transform: scale(1.04);
  }

  .content {
    padding: 22px;
  }

  h2 {
    font-size: 23px;
    line-height: 1.35;
  }

  h2 a:hover {
    color: #59634a;
  }

  .content p {
    color: #74756c;
    font-size: 13px;
    line-height: 1.8;
  }

  /* Date and Location */

  .meta {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 20px;
    color: #929187;
    font-size: 11px;
  }

  /* Visitor Counter */

  .visit-counter {
    display: flex;
    align-items: center;
    gap: 7px;
    margin-top: 18px;
    color: #85857c;
    font-size: 12px;
  }

  .visit-icon {
    flex-shrink: 0;
    color: #59634a;
  }

  .visit-count {
    color: #59634a;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  .visit-label {
    color: #85857c;
  }

  /* Footer */

  footer {
    padding: 30px 24px;
    border-top: 1px solid #e9e6dc;
    text-align: center;
  }

  footer p {
    color: #85857c;
    font-size: 12px;
  }

  /* Responsive */

  @media (max-width: 900px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 600px) {
    .header {
      align-items: flex-start;
      flex-direction: column;
    }

    nav {
      width: 100%;
      justify-content: space-between;
      gap: 10px;
      font-size: 12px;
    }

    main {
      width: calc(100% - 36px);
    }

    .intro {
      padding-top: 55px;
    }

    .grid {
      grid-template-columns: 1fr;
    }

    .cover {
      height: 230px;
    }
  }
</style>
