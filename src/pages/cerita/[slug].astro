
---
import GoatCounter from "../../components/GoatCounter.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const stories = await getCollection("stories");

  return stories.map((story) => ({
    params: { slug: story.id },
    props: { story },
  }));
}

const { story } = Astro.props;
const { Content } = await render(story);

const formatDate = new Intl.DateTimeFormat("id-ID", {
  day: "numeric",
  month: "long",
  year: "numeric",
}).format(story.data.date);

const canonicalURL = new URL(
  `/cerita/${story.id}/`,
  Astro.site
).href;

const coverURL = new URL(
  story.data.cover,
  Astro.site
).href;

const videoURL = story.data.video
  ? new URL(story.data.video, Astro.site).href
  : undefined;

const gallery = story.data.gallery ?? [];
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

    <meta
      name="description"
      content={story.data.description}
    />

    <meta name="theme-color" content="#f8f7f3" />

    <title>{story.data.title} — Kopi & Kayuhan</title>

    <GoatCounter />

    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph Metadata -->
    <meta property="og:type" content="article" />
    <meta property="og:site_name" content="Kopi & Kayuhan" />
    <meta property="og:locale" content="id_ID" />

    <meta
      property="og:title"
      content={`${story.data.title} — Kopi & Kayuhan`}
    />

    <meta
      property="og:description"
      content={story.data.description}
    />

    <meta
      property="og:url"
      content={canonicalURL}
    />

    <meta
      property="og:image"
      content={coverURL}
    />

    <meta
      property="og:image:secure_url"
      content={coverURL}
    />

    <meta
      property="og:image:alt"
      content={story.data.title}
    />

    <meta
      property="article:published_time"
      content={story.data.date.toISOString()}
    />

    <!-- Twitter / Social Media Metadata -->
    <meta name="twitter:card" content="summary_large_image" />

    <meta
      name="twitter:title"
      content={`${story.data.title} — Kopi & Kayuhan`}
    />

    <meta
      name="twitter:description"
      content={story.data.description}
    />

    <meta
      name="twitter:image"
      content={coverURL}
    />
  </head>

  <body>
    <header>
      <a class="brand" href="/">Kopi & Kayuhan</a>

      <nav>
        <a href="/#beranda">Beranda</a>
        <a href="/cerita/">Cerita</a>
        <a href="/#galeri">Galeri</a>
        <a href="/tentang/">Tentang</a>
      </nav>
    </header>

    <main>
      <a href="/cerita/" class="back">
        ← Kembali ke semua cerita
      </a>

      <article>
        <div class="article-heading">
          <span class="category">{story.data.category}</span>

          <h1>{story.data.title}</h1>

          <p class="description">
            {story.data.description}
          </p>

          <div class="meta">
            <time datetime={story.data.date.toISOString()}>
              {formatDate}
            </time>

            {story.data.location && (
              <span>{story.data.location}</span>
            )}
          </div>

          <!-- Visitor Counter -->
          <div class="visit-counter">
            <svg
              class="visit-icon"
              xmlns="http://www.w3.org/2000/svg"
              width="17"
              height="17"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7-10-7-10-7Z" />
              <circle cx="12" cy="12" r="3" />
            </svg>

            <span id="story-visit-count">
              Memuat kunjungan...
            </span>

            <span class="visit-label">
              kali dikunjungi
            </span>
          </div>
        </div>

        <!-- Cover Image -->
        <img
          class="cover"
          src={coverURL}
          alt={story.data.title}
        />

        <!-- Video Player -->
        {videoURL && (
          <section class="story-video">
            <h2>Video Kegiatan</h2>

            <video
              class="video-player"
              controls
              playsinline
              preload="metadata"
              aria-label={`Video kegiatan: ${story.data.title}`}
            >
              <source src={videoURL} type="video/mp4" />
              Browser Anda tidak mendukung pemutaran video.
            </video>
          </section>
        )}

        <!-- Story Content -->
        <div class="article-body">
          <Content />
        </div>

        <!-- Share Button -->
        <div class="share-section">
          <button
            type="button"
            id="share-button"
            class="share-button"
            data-title={story.data.title}
            data-description={story.data.description}
            data-url={canonicalURL}
          >
            <span>↗</span>
            Bagikan Cerita
          </button>
        </div>

        <!-- Photo Gallery -->
        {gallery.length > 0 && (
          <section class="story-gallery">
            <h2>Potret Perjalanan</h2>

            <p>
              Beberapa momen yang tersimpan dalam cerita ini.
            </p>

            <div class="gallery-grid">
              {gallery.map((photo, index) => (
                <img
                  src={photo}
                  alt={`${story.data.title} - foto ${index + 1}`}
                  loading="lazy"
                />
              ))}
            </div>
          </section>
        )}
      </article>
    </main>

    <footer>
      <a href="/">Kopi & Kayuhan</a>
      <p>Secangkir kopi, sejuta cerita.</p>
    </footer>

    <!-- Share Function -->
    <script>
      const shareButton =
        document.querySelector<HTMLButtonElement>("#share-button");

      shareButton?.addEventListener("click", async () => {
        const title = shareButton.dataset.title ?? "";
        const description = shareButton.dataset.description ?? "";
        const url = shareButton.dataset.url ?? window.location.href;

        const shareData = {
          title,
          text: description,
          url,
        };

        if (
          navigator.share &&
          (!navigator.canShare || navigator.canShare(shareData))
        ) {
          try {
            await navigator.share(shareData);
          } catch (error) {
            if (
              error instanceof Error &&
              error.name !== "AbortError"
            ) {
              console.error("Gagal membagikan cerita:", error);
            }
          }
        } else {
          const whatsappURL = `https://api.whatsapp.com/send?text=${encodeURIComponent(
            `${title}\n\n${description}\n\n${url}`
          )}`;

          window.open(
            whatsappURL,
            "_blank",
            "noopener,noreferrer"
          );
        }
      });
    </script>

    <!-- GoatCounter JSON Visitor Counter -->
    <script is:inline>
      (async function loadStoryVisitCount() {
        const counter = document.getElementById(
          "story-visit-count"
        );

        if (!counter) return;

        const path = window.location.pathname;

        const endpoint =
          "https://kopi-kayuhan.goatcounter.com/counter/" +
          encodeURIComponent(path) +
          ".json";

        try {
          const response = await fetch(endpoint);

          if (response.status === 404) {
            counter.textContent = "0";
            return;
          }

          if (!response.ok) {
            throw new Error(
              `GoatCounter returned ${response.status}`
            );
          }

          const data = await response.json();

          counter.textContent = data.count ?? "0";
        } catch (error) {
          console.error("Gagal mengambil visitor count:", error);
          counter.textContent = "-";
        }
      })();
    </script>
  </body>
</html>

<style>
  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    background: #f8f7f3;
    color: #292c25;
    font-family: "DM Sans", Arial, sans-serif;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  /* Header */

  header {
    min-height: 78px;
    padding: 20px max(24px, calc((100% - 1120px) / 2));
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    border-bottom: 1px solid #e9e6dc;
  }

  .brand {
    font-family: Georgia, serif;
    font-size: 21px;
    font-weight: bold;
  }

  nav {
    display: flex;
    gap: 28px;
    color: #686a60;
    font-size: 14px;
  }

  /* Main Content */

  main {
    width: min(850px, calc(100% - 48px));
    margin: auto;
    padding: 55px 0 90px;
  }

  .back {
    color: #59634a;
    font-size: 13px;
    font-weight: bold;
  }

  .article-heading {
    padding: 45px 0 30px;
  }

  .category {
    color: #7a8069;
    font-size: 11px;
    font-weight: bold;
    letter-spacing: 1.5px;
  }

  h1 {
    margin: 15px 0;
    font-family: Georgia, serif;
    font-size: clamp(36px, 6vw, 54px);
    line-height: 1.2;
  }

  .description {
    color: #74756c;
    font-size: 16px;
    line-height: 1.8;
  }

  .meta {
    display: flex;
    gap: 20px;
    margin-top: 24px;
    color: #929187;
    font-size: 12px;
  }

  /* Visitor Counter */

  .visit-counter {
    display: flex;
    align-items: center;
    gap: 7px;
    margin-top: 18px;
    color: #85857c;
    font-size: 13px;
  }

  .visit-icon {
    flex-shrink: 0;
    color: #59634a;
  }

  #story-visit-count {
    color: #59634a;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  .visit-label {
    color: #85857c;
  }

  /* Cover */

  .cover {
    display: block;
    width: 100%;
    max-height: 480px;
    object-fit: cover;
  }

  /* Video */

  .story-video {
    margin-top: 35px;
  }

  .story-video h2 {
    margin: 0 0 16px;
    color: #292c25;
    font-family: Georgia, serif;
    font-size: 25px;
  }

  .video-player {
    display: block;
    width: 100%;
    max-height: 500px;
    aspect-ratio: 16 / 9;
    background: #222;
    border-radius: 4px;
    object-fit: contain;
  }

  /* Article Body */

  .article-body {
    max-width: 700px;
    margin: 45px auto 0;
    color: #45463f;
    font-size: 16px;
    line-height: 2;
  }

  .article-body :global(h2),
  .article-body :global(h3) {
    margin-top: 35px;
    color: #292c25;
    font-family: Georgia, serif;
  }

  .article-body :global(img) {
    max-width: 100%;
    height: auto;
  }

  /* Share Button */

  .share-section {
    margin: 35px 0;
    display: flex;
    justify-content: center;
  }

  .share-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 13px 24px;
    border: none;
    border-radius: 6px;
    background: #59634a;
    color: #ffffff;
    font-family: inherit;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.2s ease;
  }

  .share-button:hover {
    background: #424b36;
  }

  /* Gallery */

  .story-gallery {
    margin-top: 65px;
  }

  .story-gallery h2 {
    margin-bottom: 8px;
    font-family: Georgia, serif;
    font-size: 28px;
  }

  .story-gallery > p {
    margin-bottom: 24px;
    color: #85857c;
    font-size: 14px;
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }

  .gallery-grid img {
    width: 100%;
    height: 260px;
    object-fit: cover;
    border-radius: 4px;
  }

  /* Footer */

  footer {
    padding: 30px 24px;
    border-top: 1px solid #e9e6dc;
    text-align: center;
  }

  footer a {
    font-family: Georgia, serif;
    font-weight: bold;
  }

  footer p {
    color: #85857c;
    font-size: 12px;
  }

  /* Responsive */

  @media (max-width: 600px) {
    header {
      align-items: flex-start;
      flex-direction: column;
    }

    nav {
      width: 100%;
      justify-content: space-between;
      gap: 10px;
      font-size: 12px;
    }

    main {
      width: calc(100% - 36px);
    }

    .gallery-grid {
      grid-template-columns: 1fr;
    }

    .gallery-grid img {
      height: 240px;
    }

    .video-player {
      max-height: 350px;
    }
  }
</style>
